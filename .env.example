# Redis connection URL
REDIS_URL=

# Backend API endpoint for fetching route-device mappings
API_ROUTES_URL=

# Backend API endpoint for fetching route directions (Google Maps polyline)
# Use {route_id} as a placeholder — it will be replaced dynamically per route
API_DIRECTIONS_BASE_URL=

# Bearer token for API authentication
API_BEARER_TOKEN=your-bearer-token-here

# Redis channel prefix for publishing predicted positions
TOPIC_PREDICTED_OUT=gps:predicted
